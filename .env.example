NODE_ENV=development
PORT=4000
STORE=memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pantrypilot
WEB_ORIGIN=http://localhost:3000

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

DEVICE_PROVIDER=simulator
COMMERCE_PROVIDER=mock
# mock | paypal. paypal = PayPal SANDBOX only (Vault consent, authorize, capture/void). Live PayPal is refused.
PAYMENT_PROVIDER=mock
# Only meaningful with mock providers in this build. Live providers are refused at startup.
AUTONOMOUS_PURCHASING_ENABLED=true
GLOBAL_PURCHASE_KILL_SWITCH=false
DEVICE_SIGNING_SECRET=dev-only-device-secret
WEBHOOK_SECRET=dev-only-webhook-secret

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be https://api-m.sandbox.paypal.com (default). Anything else is refused at startup.
PAYPAL_BASE_URL=
# Where PayPal sends the browser after consent. Must be reachable by the browser.
API_PUBLIC_URL=http://localhost:4000
SMARTTHINGS_TOKEN=

# --- Stores (all optional; leave unset to stay on the mock store) ---
# Comma list. Live stores need the credentials below or startup fails.
COMMERCE_PROVIDERS=mock
# Kroger Public API (developer.kroger.com). Search + add-to-cart only; NO checkout endpoint exists.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_LOCATION_ID=
KROGER_REDIRECT_URI=http://localhost:4000/api/v1/integrations/kroger/callback
# 32 random bytes, base64. Encrypts stored user tokens. Required for Kroger.
INTEGRATION_ENCRYPTION_KEY=
# Walmart.io affiliate catalogue (read-only; Walmart documents no consumer ordering API)
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY_B64=
# Instacart Developer Platform: shopping-list handoff link only
INSTACART_API_KEY=
INSTACART_ENV=dev
