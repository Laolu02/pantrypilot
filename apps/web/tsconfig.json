{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve", "lib": ["dom", "dom.iterable", "es2022"], "allowJs": false, "incremental": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }, "noEmit": true, "types": ["node"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
